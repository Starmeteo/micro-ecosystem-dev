{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Window metadata, drag and resize for owned ecosystem views.",
  "windows": ["editor", "observe", "panel", "layout"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
